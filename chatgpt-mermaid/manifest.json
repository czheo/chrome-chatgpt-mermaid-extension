{
  "manifest_version": 3,
  "name": "ChatGPT Mermaid",
  "version": "0.1.0",
  "description": "Toggle mermaid code blocks between source and rendered diagram in ChatGPT.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "mermaid.min.js",
        "mermaid-patch.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
